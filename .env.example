# 阿里云百炼 API Key。不要把真实 Key 提交到 Git。
DASHSCOPE_API_KEY=sk-your-key

# 中国内地北京地域的 OpenAI 兼容地址。
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 默认使用已开通且支持 Function Calling 的 qwen-plus。
# 若业务空间已开通 Kimi K3，可改为 kimi/kimi-k3。
MODEL_ID=qwen-plus

# 可选：s11 在连续三次 HTTP 529 后切换到该模型；留空表示不降级。
FALLBACK_MODEL_ID=
